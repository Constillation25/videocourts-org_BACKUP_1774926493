<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VideoCourts™ — Enterprise Justice Platform</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://vjs.zencdn.net/8.10.0/video-js.css" rel="stylesheet" />
<style>
*{box-sizing:border-box}
body{font-family:system-ui,sans-serif;background:#0b1120;color:#e2e8f0;min-height:100vh}
.grad-text{background:linear-gradient(135deg,#3b82f6,#06b6d4);-webkit-background-clip:text;color:transparent}
.grad-bg{background:linear-gradient(135deg,#3b82f6,#06b6d4)}
.btn{padding:10px 20px;border-radius:10px;font-weight:600;font-size:14px;cursor:pointer;border:none;display:inline-flex;align-items:center;gap:8px;transition:all .2s}
.btn-primary{background:linear-gradient(135deg,#3b82f6,#06b6d4);color:white}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(59,130,246,.35)}
.btn-secondary{background:#1e293b;color:#e2e8f0;border:1px solid #334155}
.btn-secondary:hover{background:#334155}
.btn-success{background:#10b981;color:white}
.btn-danger{background:#ef4444;color:white}
.btn-alfai{background:linear-gradient(135deg,#8b5cf6,#ec4899);color:white}
.btn-alfai:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(139,92,246,.4)}
.btn-legalshield{background:linear-gradient(135deg,#0056b3,#00a8e8);color:white}
.input{width:100%;background:#0f172a;border:1px solid #1e293b;color:#e2e8f0;padding:10px 14px;border-radius:10px;font-size:14px}
.input:focus{outline:none;border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.15)}
.view{display:none}.view.active{display:block}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.85);display:none;align-items:center;justify-content:center;z-index:2000}
.modal.show{display:flex}
.modal-content{background:#111827;border:1px solid #3b82f6;border-radius:20px;max-width:620px;width:90%;max-height:90vh;overflow-y:auto}
.chat-bubble{margin-bottom:12px;padding:12px 16px;border-radius:12px;max-width:85%;word-wrap:break-word}
.chat-bubble.user{background:linear-gradient(135deg,#3b82f6,#06b6d4);color:white;margin-left:auto}
.chat-bubble.bot{background:#1e293b}
.video-tile{background:#111827;border:1px solid #1e293b;border-radius:12px;padding:12px}
#chat-panel{display:none}
#chat-panel.open{display:flex}
.feature-card{background:#111827;border:1px solid #1e293b;border-radius:20px;padding:28px;transition:all .3s;cursor:pointer}
.feature-card:hover{border-color:#3b82f6;transform:translateY(-4px);box-shadow:0 20px 40px rgba(59,130,246,.15)}
.stat-card{background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid #334155;border-radius:16px;padding:24px;text-align:center}
.lawyer-card{background:#111827;border:1px solid #1e293b;border-radius:16px;padding:20px;transition:all .2s}
.lawyer-card:hover{border-color:#3b82f6;transform:translateY(-2px)}
.mock-scenario{background:linear-gradient(135deg,rgba(139,92,246,.1),rgba(236,72,153,.1));border:1px solid rgba(139,92,246,.3);border-radius:16px;padding:20px;transition:all .2s;cursor:pointer}
.mock-scenario:hover{border-color:#ec4899;transform:translateY(-2px)}
.alfai-tool{background:#111827;border:1px solid #1e293b;border-radius:16px;padding:20px;transition:all .2s;cursor:pointer}
.alfai-tool:hover{border-color:#8b5cf6;transform:translateY(-2px)}
.rating-star{color:#fbbf24}
.rating-star-empty{color:#475569}
</style>
</head>
<body>

<!-- Navigation -->
<nav class="sticky top-0 z-50 bg-slate-950/95 backdrop-blur border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <div onclick="showView('home')" class="flex items-center gap-3 cursor-pointer">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white text-2xl grad-bg"><i class="fas fa-gavel"></i></div>
      <div><h1 class="text-2xl font-bold">VideoCourts<span class="text-xs text-slate-400">™</span></h1></div>
    </div>
    <div class="flex items-center gap-4 text-sm">
      <a onclick="showView('home')" class="cursor-pointer hover:text-white">Home</a>
      <a onclick="showView('casecheck')" class="cursor-pointer hover:text-white">Case Lookup</a>
      <a onclick="showView('hearing')" class="cursor-pointer hover:text-white">Hearings</a>
      <a onclick="showView('bail')" class="cursor-pointer hover:text-white">Bail</a>
      <a onclick="showView('courtroom')" class="cursor-pointer hover:text-white">Courtroom</a>
      <a onclick="showView('alfai')" class="cursor-pointer hover:text-white text-purple-400"><i class="fas fa-wand-magic-sparkles"></i> Alfai</a>
      <a onclick="showView('mocktrial')" class="cursor-pointer hover:text-white text-pink-400"><i class="fas fa-scale-balanced"></i> Mock Trial</a>
      <a onclick="showView('directory')" class="cursor-pointer hover:text-white text-cyan-400"><i class="fas fa-users"></i> Lawyers</a>
      <button onclick="openLegalShield()" class="btn btn-legalshield text-sm px-5 py-2"><i class="fas fa-shield-halved"></i> LegalShield</button>
      <button onclick="openChat()" class="btn btn-primary text-sm px-5 py-2"><i class="fas fa-robot"></i> Grok AI</button>
    </div>
  </div>
</nav>

<!-- HOME VIEW -->
<div id="view-home" class="view active">
  <div class="relative max-w-7xl mx-auto px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-6xl font-bold mb-6 grad-text">The Future of Justice is Here</h1>
      <p class="text-xl text-slate-400 max-w-2xl mx-auto mb-8">Secure virtual courtrooms, AI legal assistant, bail bonding, mock trials, and lawyer directory — all in one platform.</p>
      <div class="flex gap-4 justify-center flex-wrap">
        <button onclick="showView('casecheck')" class="btn btn-primary text-lg px-8 py-4"><i class="fas fa-search"></i> Lookup a Case</button>
        <button onclick="showView('courtroom')" class="btn btn-secondary text-lg px-8 py-4"><i class="fas fa-video"></i> Enter Courtroom</button>
        <button onclick="showView('alfai')" class="btn btn-alfai text-lg px-8 py-4"><i class="fas fa-wand-magic-sparkles"></i> Try Alfai</button>
      </div>
    </div>

    <!-- Hero Image -->
    <div class="mb-16 rounded-3xl overflow-hidden border border-slate-800 shadow-2xl">
      <img src="https://image.qwenlm.ai/public_source/596baf5e-565b-4942-b65f-bd224fbf6eb9/18a561901-70a1-429f-9b34-9f43ac7b91bd.png" alt="Virtual Courtroom" style="width:100%;height:400px;object-fit:cover">
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-4 gap-6 mb-16">
      <div class="stat-card">
        <div class="text-4xl font-bold grad-text mb-2">12,450+</div>
        <div class="text-slate-400">Cases Processed</div>
      </div>
      <div class="stat-card">
        <div class="text-4xl font-bold grad-text mb-2">98.7%</div>
        <div class="text-slate-400">Uptime</div>
      </div>
      <div class="stat-card">
        <div class="text-4xl font-bold grad-text mb-2">2,300+</div>
        <div class="text-slate-400">Attorneys</div>
      </div>
      <div class="stat-card">
        <div class="text-4xl font-bold grad-text mb-2">24/7</div>
        <div class="text-slate-400">AI Support</div>
      </div>
    </div>

    <!-- Features -->
    <h2 class="text-3xl font-bold text-center mb-8">Platform Features</h2>
    <div class="grid grid-cols-3 gap-6 mb-16">
      <div class="feature-card" onclick="showView('courtroom')">
        <div class="text-4xl text-blue-400 mb-4"><i class="fas fa-video"></i></div>
        <h3 class="text-xl font-bold mb-2">Virtual Courtrooms</h3>
        <p class="text-slate-400">HD video hearings with encrypted connections and court-grade security.</p>
      </div>
      <div class="feature-card" onclick="openChat()">
        <div class="text-4xl text-cyan-400 mb-4"><i class="fas fa-robot"></i></div>
        <h3 class="text-xl font-bold mb-2">Grok AI Assistant</h3>
        <p class="text-slate-400">24/7 AI-powered legal research and case preparation support.</p>
      </div>
      <div class="feature-card" onclick="showView('bail')">
        <div class="text-4xl text-emerald-400 mb-4"><i class="fas fa-hand-holding-dollar"></i></div>
        <h3 class="text-xl font-bold mb-2">Bail Bonding</h3>
        <p class="text-slate-400">Instant bail processing with licensed bonding partners.</p>
      </div>
      <div class="feature-card" onclick="showView('alfai')">
        <div class="text-4xl text-purple-400 mb-4"><i class="fas fa-wand-magic-sparkles"></i></div>
        <h3 class="text-xl font-bold mb-2">Alfai AI Suite</h3>
        <p class="text-slate-400">Advanced AI legal drafting, contract review, and case analysis.</p>
      </div>
      <div class="feature-card" onclick="showView('mocktrial')">
        <div class="text-4xl text-pink-400 mb-4"><i class="fas fa-scale-balanced"></i></div>
        <h3 class="text-xl font-bold mb-2">Mock Trial</h3>
        <p class="text-slate-400">Practice courtroom arguments with AI judge feedback.</p>
      </div>
      <div class="feature-card" onclick="showView('directory')">
        <div class="text-4xl text-amber-400 mb-4"><i class="fas fa-users"></i></div>
        <h3 class="text-xl font-bold mb-2">Lawyers Directory</h3>
        <p class="text-slate-400">Connect with verified attorneys across all practice areas.</p>
      </div>
    </div>
  </div>
</div>

<!-- CASE CHECK VIEW -->
<div id="view-casecheck" class="view p-8 max-w-4xl mx-auto">
  <h2 class="text-3xl font-bold mb-6">Case Lookup</h2>
  <input id="case-input" type="text" placeholder="Enter Case Number (e.g. CR-2025-00421)" class="input text-lg py-6 mb-6 w-full">
  <button onclick="searchCase()" class="btn btn-primary w-full py-6 text-lg">Search Case</button>
  <div id="case-result" class="mt-8"></div>

  <div class="mt-12">
    <h3 class="text-xl font-bold mb-4">Recent Cases</h3>
    <div class="space-y-3">
      <div onclick="document.getElementById('case-input').value='CR-2025-00421';searchCase()" class="video-tile cursor-pointer flex justify-between items-center">
        <div>
          <div class="font-semibold">CR-2025-00421</div>
          <div class="text-sm text-slate-400">State v. Johnson • Criminal</div>
        </div>
        <span class="text-emerald-400 text-sm">Pending</span>
      </div>
      <div onclick="document.getElementById('case-input').value='CV-2025-00892';searchCase()" class="video-tile cursor-pointer flex justify-between items-center">
        <div>
          <div class="font-semibold">CV-2025-00892</div>
          <div class="text-sm text-slate-400">Smith v. Acme Corp • Civil</div>
        </div>
        <span class="text-blue-400 text-sm">Scheduled</span>
      </div>
      <div onclick="document.getElementById('case-input').value='FM-2025-00156';searchCase()" class="video-tile cursor-pointer flex justify-between items-center">
        <div>
          <div class="font-semibold">FM-2025-00156</div>
          <div class="text-sm text-slate-400">Doe v. Doe • Family</div>
        </div>
        <span class="text-amber-400 text-sm">In Review</span>
      </div>
    </div>
  </div>
</div>

<!-- HEARING VIEW -->
<div id="view-hearing" class="view p-8 max-w-5xl mx-auto">
  <h2 class="text-3xl font-bold mb-6">Upcoming Hearings</h2>
  <div class="grid grid-cols-2 gap-6">
    <div class="video-tile">
      <div class="text-sm text-cyan-400 font-semibold mb-2">CR-2025-00421</div>
      <h3 class="font-bold text-lg mb-2">State v. Johnson</h3>
      <p class="text-slate-400 text-sm mb-3">Arraignment Hearing</p>
      <div class="flex items-center gap-2 text-sm text-slate-400 mb-4"><i class="far fa-calendar"></i> July 25, 2025 • 10:00 AM</div>
      <button onclick="showView('courtroom')" class="btn btn-primary w-full">Join Hearing</button>
    </div>
    <div class="video-tile">
      <div class="text-sm text-cyan-400 font-semibold mb-2">CV-2025-00892</div>
      <h3 class="font-bold text-lg mb-2">Smith v. Acme Corp</h3>
      <p class="text-slate-400 text-sm mb-3">Pre-Trial Conference</p>
      <div class="flex items-center gap-2 text-sm text-slate-400 mb-4"><i class="far fa-calendar"></i> July 28, 2025 • 2:00 PM</div>
      <button onclick="showView('courtroom')" class="btn btn-primary w-full">Join Hearing</button>
    </div>
    <div class="video-tile">
      <div class="text-sm text-cyan-400 font-semibold mb-2">FM-2025-00156</div>
      <h3 class="font-bold text-lg mb-2">Doe v. Doe</h3>
      <p class="text-slate-400 text-sm mb-3">Custody Mediation</p>
      <div class="flex items-center gap-2 text-sm text-slate-400 mb-4"><i class="far fa-calendar"></i> August 1, 2025 • 9:00 AM</div>
      <button onclick="showView('courtroom')" class="btn btn-primary w-full">Join Hearing</button>
    </div>
    <div class="video-tile">
      <div class="text-sm text-cyan-400 font-semibold mb-2">TR-2025-01204</div>
      <h3 class="font-bold text-lg mb-2">People v. Garcia</h3>
      <p class="text-slate-400 text-sm mb-3">Traffic Violation</p>
      <div class="flex items-center gap-2 text-sm text-slate-400 mb-4"><i class="far fa-calendar"></i> August 5, 2025 • 11:30 AM</div>
      <button onclick="showView('courtroom')" class="btn btn-primary w-full">Join Hearing</button>
    </div>
  </div>
</div>

<!-- BAIL VIEW -->
<div id="view-bail" class="view p-8 max-w-5xl mx-auto">
  <h2 class="text-3xl font-bold mb-6">Bail Bonding Services</h2>
  <div class="bg-gradient-to-br from-blue-900/30 to-cyan-900/30 border border-blue-500/30 rounded-3xl p-8 mb-8">
    <h3 class="text-2xl font-bold mb-4">Post Bail Instantly</h3>
    <p class="text-slate-300 mb-6">Secure release through our licensed bonding partners. 10% fee, 24/7 processing.</p>
    <div class="grid grid-cols-3 gap-4">
      <div class="bg-slate-900/50 rounded-xl p-4"><div class="text-3xl font-bold grad-text">$5,000</div><div class="text-sm text-slate-400">Average Bail</div></div>
      <div class="bg-slate-900/50 rounded-xl p-4"><div class="text-3xl font-bold grad-text">15 min</div><div class="text-sm text-slate-400">Avg Processing</div></div>
      <div class="bg-slate-900/50 rounded-xl p-4"><div class="text-3xl font-bold grad-text">100%</div><div class="text-sm text-slate-400">Secure</div></div>
    </div>
  </div>

  <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6">
    <h3 class="text-xl font-bold mb-4">Start Bail Process</h3>
    <div class="grid grid-cols-2 gap-4 mb-4">
      <div><label class="text-sm text-slate-400 mb-2 block">Defendant Name</label><input type="text" placeholder="Full legal name" class="input"></div>
      <div><label class="text-sm text-slate-400 mb-2 block">Case Number</label><input type="text" placeholder="CR-2025-XXXXX" class="input"></div>
      <div><label class="text-sm text-slate-400 mb-2 block">Bail Amount</label><input type="text" placeholder="$0.00" class="input"></div>
      <div><label class="text-sm text-slate-400 mb-2 block">Court Location</label><input type="text" placeholder="County / State" class="input"></div>
    </div>
    <button onclick="alert('Bail request submitted! A bonding agent will contact you within 15 minutes.')" class="btn btn-success w-full py-4 text-lg"><i class="fas fa-hand-holding-dollar"></i> Request Bail Bond</button>
  </div>
</div>

<!-- COURTROOM VIEW -->
<div id="view-courtroom" class="view p-8 max-w-6xl mx-auto">
  <h2 class="text-3xl font-bold mb-6">Live Courtroom</h2>
  <div class="aspect-video bg-black rounded-3xl overflow-hidden mb-6">
    <video id="courtroom-player" class="video-js w-full h-full" controls preload="auto">
      <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" type="video/mp4">
    </video>
  </div>
  <div class="grid grid-cols-4 gap-4">
    <div class="video-tile">
      <div class="aspect-video bg-slate-800 rounded-lg mb-2 flex items-center justify-center"><i class="fas fa-user-tie text-4xl text-slate-600"></i></div>
      <div class="text-sm font-semibold">Judge Martinez</div>
      <div class="text-xs text-slate-400">Presiding</div>
    </div>
    <div class="video-tile">
      <div class="aspect-video bg-slate-800 rounded-lg mb-2 flex items-center justify-center"><i class="fas fa-user text-4xl text-slate-600"></i></div>
      <div class="text-sm font-semibold">Defendant</div>
      <div class="text-xs text-emerald-400">Connected</div>
    </div>
    <div class="video-tile">
      <div class="aspect-video bg-slate-800 rounded-lg mb-2 flex items-center justify-center"><i class="fas fa-user-tie text-4xl text-slate-600"></i></div>
      <div class="text-sm font-semibold">Defense Counsel</div>
      <div class="text-xs text-emerald-400">Connected</div>
    </div>
    <div class="video-tile">
      <div class="aspect-video bg-slate-800 rounded-lg mb-2 flex items-center justify-center"><i class="fas fa-user-tie text-4xl text-slate-600"></i></div>
      <div class="text-sm font-semibold">Prosecutor</div>
      <div class="text-xs text-emerald-400">Connected</div>
    </div>
  </div>
  <div class="mt-6 flex gap-4">
    <button onclick="this.innerHTML=this.innerHTML.includes('Mute')?'<i class=\'fas fa-microphone\'></i> Unmute':'<i class=\'fas fa-microphone-slash\'></i> Mute'" class="btn btn-primary flex-1"><i class="fas fa-microphone"></i> Mute</button>
    <button onclick="this.innerHTML=this.innerHTML.includes('Camera')?'<i class=\'fas fa-video-slash\'></i> Stop Camera':'<i class=\'fas fa-video\'></i> Camera'" class="btn btn-secondary flex-1"><i class="fas fa-video"></i> Camera</button>
    <button onclick="if(confirm('Leave hearing?'))showView('home')" class="btn btn-danger flex-1"><i class="fas fa-phone-slash"></i> Leave</button>
  </div>
</div>

<!-- ALFAI VIEW -->
<div id="view-alfai" class="view p-8 max-w-6xl mx-auto">
  <div class="text-center mb-10">
    <div class="inline-block px-4 py-1 rounded-full bg-purple-500/20 text-purple-400 text-sm font-semibold mb-4">
      <i class="fas fa-wand-magic-sparkles"></i> AI Legal Intelligence Suite
    </div>
    <h1 class="text-5xl font-bold mb-4" style="background:linear-gradient(135deg,#8b5cf6,#ec4899);-webkit-background-clip:text;color:transparent">Alfai — Legal AI Powerhouse</h1>
    <p class="text-xl text-slate-400 max-w-2xl mx-auto">Advanced AI tools for legal professionals. Draft, analyze, review, and strategize with enterprise-grade AI.</p>
  </div>

  <!-- Alfai Tools Grid -->
  <div class="grid grid-cols-3 gap-6 mb-10">
    <div class="alfai-tool" onclick="openAlfaiTool('draft')">
      <div class="text-4xl text-purple-400 mb-4"><i class="fas fa-file-pen"></i></div>
      <h3 class="text-xl font-bold mb-2">Legal Drafting</h3>
      <p class="text-slate-400 text-sm">Generate motions, briefs, contracts, and pleadings in seconds.</p>
    </div>
    <div class="alfai-tool" onclick="openAlfaiTool('contract')">
      <div class="text-4xl text-pink-400 mb-4"><i class="fas fa-file-contract"></i></div>
      <h3 class="text-xl font-bold mb-2">Contract Review</h3>
      <p class="text-slate-400 text-sm">AI-powered clause analysis, risk detection, and redlining.</p>
    </div>
    <div class="alfai-tool" onclick="openAlfaiTool('research')">
      <div class="text-4xl text-cyan-400 mb-4"><i class="fas fa-magnifying-glass"></i></div>
      <h3 class="text-xl font-bold mb-2">Case Research</h3>
      <p class="text-slate-400 text-sm">Search 100M+ cases, statutes, and regulations instantly.</p>
    </div>
    <div class="alfai-tool" onclick="openAlfaiTool('predict')">
      <div class="text-4xl text-emerald-400 mb-4"><i class="fas fa-chart-line"></i></div>
      <h3 class="text-xl font-bold mb-2">Outcome Prediction</h3>
      <p class="text-slate-400 text-sm">ML models predict case outcomes with 87% accuracy.</p>
    </div>
    <div class="alfai-tool" onclick="openAlfaiTool('summarize')">
      <div class="text-4xl text-amber-400 mb-4"><i class="fas fa-compress-alt"></i></div>
      <h3 class="text-xl font-bold m